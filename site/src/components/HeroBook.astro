---
// Homepage hero: a notebook on indigo cloth.
// On load the cover swings open; its inside (endpaper + bookplate) lands on the left.
// The right-hand page turns through featured pieces: the current page lifts and turns in 3D.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { site } from '../config/site';
import { t, href, digits, price, type Lang } from '../i18n';

interface Props { lang: Lang; items: CollectionEntry<'products'>[]; total: number }
const { lang, items, total } = Astro.props;
const th = lang === 'th';
const grounds = ['var(--sage-pale)', 'var(--apricot-pale)', 'var(--butter)', '#E6DCCB', 'var(--rose-pale)', '#D9E0EA'];
---
<section class="hero-book bookcloth">
  <div class="wrap">
    <div class="book" id="book">
      <!-- Left: inside of the cover, with a bookplate -->
      <div class="page left khit">
        <div class="bookplate">
          <p class="sc">{th ? 'สมุดงานถักของแม่ · เล่มที่ ๑' : 'Mom’s crochet notebook · Volume one'}</p>
          <h1>{th ? <>ถักด้วย<em>มือแม่</em></> : <>Made by <em>Mom’s hands</em></>}</h1>
          <p class="lede">{site.tagline[lang]}{th ? ' ไม่มีใบไหนซ้ำ' : ', no two alike.'}</p>
          <div class="ctas">
            <a class="btn ink" href={href(lang, '/collection')}>{t(lang, 'cta.seeAll')} <small>{digits(lang, total)}</small></a>
            <button class="btn ghost" data-order>{t(lang, 'cta.contact')}</button>
          </div>
        </div>
      </div>

      <!-- Right: one featured piece per page -->
      <div class="page right" id="pages">
        <span class="ribbon" aria-hidden="true"></span>
        {items.map((p, i) => (
          <div class:list={['leaf-item', { active: i === 0 }]} data-i={i} inert={i === 0 ? undefined : true}>
            <a class="pic" href={href(lang, `/collection/${p.data.slug}`)} style={`--ground:${grounds[(p.data.no * 7) % 6]}`} tabindex={i === 0 ? undefined : -1}>
              <span class="ground"></span>
              <Image src={p.data.images[0]} alt={p.data.name[lang]} width={640} loading={i === 0 ? 'eager' : 'lazy'} />
            </a>
            <div class="cap">
              <span class="no">{t(lang, 'label.no')} {digits(lang, p.data.no, 2)} · {digits(lang, p.data.hours)} {t(lang, 'unit.hours')}</span>
              <a class="name" href={href(lang, `/collection/${p.data.slug}`)}>{p.data.name[lang]}</a>
              <span class="pr">{price(lang, p.data.priceFrom)}</span>
            </div>
            <span class="tag" aria-hidden="true"><span class="string"></span><span class="card"><b>{digits(lang, p.data.no, 2)}</b>{th ? 'ถักมือ' : 'handmade'}</span></span>
          </div>
        ))}
        <div class="pager">
          <button class="pg" data-turn="-1" aria-label={th ? 'หน้าก่อน' : 'Previous page'}>‹</button>
          <span class="count"><b>{digits(lang, 1)}</b> / {digits(lang, items.length)}</span>
          <button class="pg" data-turn="1" aria-label={th ? 'หน้าถัดไป' : 'Next page'}>›</button>
        </div>
      </div>

      <!-- Cover: front = bookcloth with foil title; back = endpaper with the same bookplate -->
      <div class="cover" aria-hidden="true">
        <div class="face cover-front bookcloth">
          <div class="frame">
            <span class="sc">{th ? 'สมุดงานถักของแม่' : 'Mom’s crochet notebook'}</span>
            <span class="foil">{site.name.th}</span>
            <span class="sc">{th ? 'เล่มที่ ๑' : 'Volume one'}</span>
          </div>
        </div>
        <div class="face cover-back khit" inert>
          <div class="bookplate">
            <p class="sc">{th ? 'สมุดงานถักของแม่ · เล่มที่ ๑' : 'Mom’s crochet notebook · Volume one'}</p>
            <p class="h1">{th ? <>ถักด้วย<em>มือแม่</em></> : <>Made by <em>Mom’s hands</em></>}</p>
            <p class="lede">{site.tagline[lang]}{th ? ' ไม่มีใบไหนซ้ำ' : ', no two alike.'}</p>
            <div class="ctas">
              <span class="btn ink">{t(lang, 'cta.seeAll')} <small>{digits(lang, total)}</small></span>
              <span class="btn ghost">{t(lang, 'cta.contact')}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-foot">
      <span class="dots"><span>{th ? 'ถักมือ 100%' : '100% handmade'}</span><span>{th ? 'ผ้าคราม & ไหมไทย' : 'Indigo & Thai silk'}</span><span>{t(lang, 'label.anyColour')}</span></span>
    </div>
  </div>
</section>

<style>
  .hero-book { position: relative; padding: calc(var(--header) + 32px) 0 0; overflow: hidden; color: #EDE7DA; }
  .book { position: relative; display: grid; grid-template-columns: 1fr 1fr; height: clamp(480px, calc(100svh - var(--header) - 130px), 620px); perspective: 2000px; perspective-origin: 50% 40%; }
  .page { position: relative; min-width: 0; }
  .page.left { border-radius: 4px 0 0 4px; display: grid; place-items: center; padding: 30px; overflow: hidden;
    box-shadow: inset -24px 0 30px -18px rgba(0,0,0,.45), 0 50px 80px -34px rgba(3,8,22,.85); }
  .page.right { border-radius: 0 4px 4px 0; color: var(--ink);
    background: radial-gradient(120% 90% at 70% 20%, #FFFDF8, var(--paper-hi) 55%, #EFE7D7);
    box-shadow: inset 30px 0 30px -20px rgba(60,40,15,.28), 0 2px 0 #D9CCB2, 0 4px 0 #EEE5D3, 0 6px 0 #D2C4A8, 0 8px 0 #E8DECA, 0 50px 80px -34px rgba(3,8,22,.85); }

  /* Before the cover lands the left side is just the tablecloth */
  .book:not(.opened) .page.left { visibility: hidden; }
  .book.opened .cover { display: none; }

  /* Bookplate */
  .bookplate { position: relative; width: min(450px, 100%); padding: clamp(26px, 3.4vw, 44px); color: var(--ink); background: var(--paper-hi);
    box-shadow: 0 24px 40px -24px rgba(0,0,0,.6); outline: 1px solid rgba(181,135,58,.45); outline-offset: -10px; }
  .bookplate h1, .bookplate .h1 { font: 500 clamp(46px, 5vw, 76px)/1 var(--display); margin: 14px 0 16px; }
  :global(:lang(th)) .bookplate h1, :global(:lang(th)) .bookplate .h1 { font: 400 clamp(40px, 4.2vw, 62px)/1.25 var(--serif-th); }
  .bookplate em { font-style: italic; color: var(--ochre); display: block; }
  :global(:lang(th)) .bookplate em { font-style: normal; }
  .lede { color: var(--muted); margin: 0 0 22px; font-size: 16px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .ctas small { opacity: .7; font-size: 12px; }

  /* Right page content: fixed areas, so the bag can never cover the text */
  .leaf-item { position: absolute; inset: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; padding: 46px 48px 74px 64px; visibility: hidden; }
  .leaf-item.active { visibility: visible; }
  .pic { position: relative; display: grid; place-items: center; min-height: 0; height: 100%; }
  .ground { position: absolute; left: 50%; top: 50%; width: min(72%, 62vh); aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; background: var(--ground);
    box-shadow: inset 0 0 0 10px rgba(255,255,255,.35), inset 0 0 0 11px rgba(181,135,58,.25); }
  .pic :global(img) { position: relative; max-height: 92%; max-width: 70%; width: auto; height: auto; object-fit: contain; filter: drop-shadow(0 26px 20px rgba(36,30,26,.36)); transition: transform .8s var(--ease); }
  .pic:hover :global(img) { transform: translateY(-4px) rotate(-1.5deg); }
  .cap { display: grid; grid-template-columns: 1fr auto; gap: 2px 16px; align-items: baseline; padding-top: 16px; border-top: 1px solid var(--faint); }
  .cap .no { grid-column: 1 / -1; font-size: 12px; letter-spacing: .1em; color: var(--muted); }
  .cap .name { font: 500 28px/1.2 var(--display); text-decoration: none; min-width: 0; }
  :global(:lang(th)) .cap .name { font: 400 22px/1.5 var(--serif-th); }
  .cap .name:hover { color: var(--kram); }
  .cap .pr { color: var(--ochre); font-weight: 500; white-space: nowrap; }
  .tag { position: absolute; right: 34px; top: 0; transform-origin: 50% 0; animation: swing 6s ease-in-out infinite; }
  .tag .string { display: block; width: 1px; height: 46px; margin: 0 auto; background: #BFA87E; }
  .tag .card { display: block; width: 86px; padding: 18px 8px 11px; text-align: center; background: var(--kraft); font: 500 12px/1.3 var(--body); clip-path: polygon(22% 0, 78% 0, 100% 14%, 100% 100%, 0 100%, 0 14%); position: relative; }
  .tag .card::before { content: ""; position: absolute; top: 7px; left: 50%; width: 8px; height: 8px; margin-left: -4px; border-radius: 50%; background: var(--kram-deep); box-shadow: 0 0 0 2px #E8DCC2; }
  .tag .card b { display: block; font: 500 26px/1 var(--serif-th); color: var(--kram); margin-bottom: 2px; }
  @keyframes swing { 0%,100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }
  .ribbon { position: absolute; z-index: 4; top: -6px; left: 26px; width: 22px; height: 110px; background: linear-gradient(90deg, #7E2418, #A9382A 45%, #8A2B1D); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 86%, 0 100%); transform-origin: top; animation: sway 7s ease-in-out infinite; }
  @keyframes sway { 50% { transform: rotate(2deg); } }
  .pager { position: absolute; z-index: 5; left: 64px; bottom: 20px; display: flex; align-items: center; gap: 14px; font-size: 14px; color: var(--muted); }
  .pager b { color: var(--ink); font-weight: 500; }
  .pg { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--faint); background: var(--paper-hi); cursor: pointer; font-size: 22px; line-height: 1; transition: background .3s, color .3s; }
  .pg:hover { background: var(--kram); color: #fff; }

  /* Shared 3D leaf: used by the cover and by turning pages */
  .cover, :global(.turning) { position: absolute; z-index: 8; top: 0; bottom: 0; left: 50%; width: 50%; transform-origin: left center; transform-style: preserve-3d; pointer-events: none; }
  .face, :global(.turning .face) { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .cover-front { border-radius: 0 4px 4px 0; display: grid; place-items: center; box-shadow: inset 14px 0 18px -10px rgba(0,0,0,.55), 0 40px 60px -30px rgba(3,8,22,.9); }
  .cover-back { transform: rotateY(180deg); border-radius: 4px 0 0 4px; display: grid; place-items: center; padding: 30px; box-shadow: inset 24px 0 30px -18px rgba(0,0,0,.45); }
  .cover { animation: openCover 2s cubic-bezier(.55,.05,.25,1) .5s both; }
  @keyframes openCover { from { transform: rotateY(0); } to { transform: rotateY(-180deg); } }
  .frame { display: grid; place-items: center; gap: 10px; padding: 50px 40px; border: 1px solid rgba(226,196,126,.55); outline: 1px solid rgba(226,196,126,.25); outline-offset: 8px; text-align: center; }
  .frame .sc { color: #CDB98C; }
  .frame .foil { font: 500 clamp(56px, 6vw, 90px)/1.2 var(--serif-th);
    background: linear-gradient(100deg, #8C6622 0%, #E8CD8A 22%, #B98C3D 40%, #F4E4B4 55%, #A07732 75%, #DDBB70 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }

  :global(.turning .front) { border-radius: 0 4px 4px 0; overflow: hidden; color: var(--ink); background: radial-gradient(120% 90% at 70% 20%, #FFFDF8, var(--paper-hi) 55%, #EFE7D7); }
  :global(.turning .front::after) { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(60,40,15,.25), transparent 30%, rgba(60,40,15,.0) 70%, rgba(60,40,15,.12)); }
  :global(.turning .back) { transform: rotateY(180deg); border-radius: 4px 0 0 4px; background: linear-gradient(90deg, #E6DCCA, var(--paper-hi) 60%, #F3ECDF); }
  :global(.turning.fwd) { animation: turnFwd .9s cubic-bezier(.45,.05,.3,1) both; }
  :global(.turning.back-dir) { animation: turnBack .9s cubic-bezier(.45,.05,.3,1) both; }
  /* Some browsers still draw a face's children from behind, so swap faces exactly when the page passes 90° (40% of the eased turn) */
  :global(.turning.fwd .front) { animation: frontOut .9s linear both; }
  :global(.turning.fwd .back) { animation: backIn .9s linear both; }
  :global(.turning.back-dir .front) { animation: frontIn .9s linear both; }
  :global(.turning.back-dir .back) { animation: backOut .9s linear both; }
  @keyframes frontOut { 0%, 39.5% { opacity: 1; } 40%, 100% { opacity: 0; } }
  @keyframes backIn { 0%, 39.5% { opacity: 0; } 40%, 100% { opacity: 1; } }
  @keyframes frontIn { 0%, 39.5% { opacity: 0; } 40%, 100% { opacity: 1; } }
  @keyframes backOut { 0%, 39.5% { opacity: 1; } 40%, 100% { opacity: 0; } }
  @keyframes turnFwd { 0% { transform: rotateY(0); } 85% { opacity: 1; } 100% { transform: rotateY(-178deg); opacity: 0; } }
  @keyframes turnBack { 0% { transform: rotateY(-178deg); opacity: 0; } 15% { opacity: 1; } 100% { transform: rotateY(0); } }

  .hero-foot { display: flex; justify-content: center; padding: 34px 0 30px; font-size: 14px; color: #B8C1D9; }
  .dots span + span::before { content: "·"; margin: 0 12px; opacity: .6; }

  @media (prefers-reduced-motion: reduce) {
    .cover { display: none; }
    .tag, .ribbon { animation: none; }
  }
  @media (max-width: 860px) {
    .book { grid-template-columns: 1fr; height: auto; perspective: none; }
    .cover { display: none; }
    .page.left { border-radius: 4px 4px 0 0; padding: 40px 18px; box-shadow: none; }
    .page.right { border-radius: 0 0 4px 4px; height: 540px; box-shadow: 0 40px 60px -30px rgba(3,8,22,.8); }
    .leaf-item { padding: 50px 22px 78px; }
    .pager { left: 22px; }
    .ground { width: min(78%, 300px); }
  }
</style>

<script>
  const book = document.getElementById('book');
  if (book) {
    const pages = document.getElementById('pages')!;
    const items = [...pages.querySelectorAll<HTMLElement>('.leaf-item')];
    const countEl = pages.querySelector<HTMLElement>('.count b')!;
    const thai = document.documentElement.lang === 'th';
    const fmt = (n: number) => (thai ? String(n).replace(/\d/g, (d) => '๐๑๒๓๔๕๖๗๘๙'[+d]) : String(n));
    const animate = matchMedia('(min-width: 861px) and (prefers-reduced-motion: no-preference)');

    // Cover: once it has swung over, the real left page (identical) takes its place
    const cover = book.querySelector<HTMLElement>('.cover')!;
    if (!animate.matches) book.classList.add('opened');
    else cover.addEventListener('animationend', () => book.classList.add('opened'), { once: true });

    let i = 0, busy = false;
    function show(n: number) {
      items[i].classList.remove('active'); items[i].inert = true;
      i = n;
      items[i].classList.add('active'); items[i].inert = false;
      countEl.textContent = fmt(i + 1);
    }
    function leafWith(item: HTMLElement, dir: number) {
      const leaf = document.createElement('div');
      leaf.className = 'turning ' + (dir > 0 ? 'fwd' : 'back-dir');
      leaf.setAttribute('aria-hidden', 'true');
      const front = document.createElement('div');
      front.className = 'face front';
      const copy = item.cloneNode(true) as HTMLElement;
      copy.classList.add('active'); copy.inert = true;
      front.appendChild(copy);
      const back = document.createElement('div');
      back.className = 'face back';
      leaf.append(front, back);
      book!.appendChild(leaf);
      return leaf;
    }
    function go(dir: number) {
      if (busy) return;
      const next = (i + dir + items.length) % items.length;
      if (!animate.matches || !book!.classList.contains('opened')) { show(next); return; }
      busy = true;
      // Forward: the current page lifts away, the next is already underneath.
      // Back: the previous page swings in from the left and settles on top.
      const leaf = leafWith(dir > 0 ? items[i] : items[next], dir);
      if (dir > 0) show(next);
      leaf.addEventListener('animationend', () => { if (dir < 0) show(next); leaf.remove(); busy = false; }, { once: true });
    }
    book.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-turn]');
      if (b) go(Number(b.dataset.turn));
    });
    addEventListener('keydown', (e) => {
      if (!(e.target as HTMLElement).closest('input, textarea, select') && book.getBoundingClientRect().bottom > 0 && scrollY < innerHeight) {
        if (e.key === 'ArrowRight') go(1);
        if (e.key === 'ArrowLeft') go(-1);
      }
    });
    let x0 = 0;
    pages.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    pages.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1); });
  }
</script>
