---
// Homepage hero: an open notebook on indigo cloth.
// The cover swings open once on load; the right-hand page turns through featured pieces.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { site } from '../config/site';
import { t, href, digits, price, type Lang } from '../i18n';

interface Props { lang: Lang; items: CollectionEntry<'products'>[]; total: number }
const { lang, items, total } = Astro.props;
const th = lang === 'th';
const grounds = ['var(--sage-pale)', 'var(--apricot-pale)', 'var(--butter)', '#E6DCCB', 'var(--rose-pale)', '#D9E0EA'];
---
<section class="hero-book bookcloth">
  <div class="wrap">
    <div class="book" id="book" data-count={items.length}>
      <!-- Left: endpaper with a bookplate -->
      <div class="page left khit">
        <div class="bookplate">
          <p class="sc">{th ? 'สมุดงานถักของแม่ · เล่มที่ ๑' : 'Mom’s crochet notebook · Volume one'}</p>
          <h1>{th ? <>ถักด้วย<em>มือแม่</em></> : <>Made by <em>Mom’s hands</em></>}</h1>
          <p class="lede">{site.tagline[lang]}{th ? ' ไม่มีใบไหนซ้ำ' : ', no two alike.'}</p>
          <div class="ctas">
            <a class="btn ink" href={href(lang, '/collection')}>{t(lang, 'cta.seeAll')} <small>{digits(lang, total)}</small></a>
            <button class="btn ghost" data-order>{t(lang, 'cta.contact')}</button>
          </div>
        </div>
      </div>

      <!-- Right: one featured piece per page -->
      <div class="page right">
        <div class="ribbon" aria-hidden="true"></div>
        {items.map((p, i) => (
          <div class:list={['leaf-item', { active: i === 0 }]} data-i={i} aria-hidden={i === 0 ? undefined : 'true'}>
            <a class="pic" href={href(lang, `/collection/${p.data.slug}`)} style={`--ground:${grounds[(p.data.no * 7) % 6]}`}>
              <Image src={p.data.images[0]} alt={p.data.name[lang]} width={640} loading={i === 0 ? 'eager' : 'lazy'} />
            </a>
            <div class="cap">
              <span class="no">{t(lang, 'label.no')} {digits(lang, p.data.no, 2)}</span>
              <a class="name" href={href(lang, `/collection/${p.data.slug}`)}>{p.data.name[lang]}</a>
              <span class="pr">{price(lang, p.data.priceFrom)}</span>
            </div>
            <div class="tag" aria-hidden="true"><span class="string"></span><span class="card"><b>{digits(lang, p.data.no, 2)}</b>{digits(lang, p.data.hours)} {t(lang, 'unit.hours')}</span></div>
          </div>
        ))}
        <div class="turn" aria-hidden="true"></div>
        <div class="pager">
          <button class="pg" data-turn="-1" aria-label={th ? 'หน้าก่อน' : 'Previous page'}>‹</button>
          <span class="count"><b>{digits(lang, 1)}</b> / {digits(lang, items.length)}</span>
          <button class="pg" data-turn="1" aria-label={th ? 'หน้าถัดไป' : 'Next page'}>›</button>
        </div>
      </div>

      <!-- Cover: opens once on load -->
      <div class="cover" aria-hidden="true">
        <div class="cover-front bookcloth">
          <div class="frame">
            <span class="sc">{th ? 'สมุดงานถักของแม่' : 'Mom’s crochet notebook'}</span>
            <span class="foil">{site.name.th}</span>
            <span class="sc">{th ? 'เล่มที่ ๑' : 'Volume one'}</span>
          </div>
        </div>
        <div class="cover-back khit"></div>
      </div>
    </div>
    <div class="hero-foot">
      <span class="dots"><span>{th ? 'ถักมือ 100%' : '100% handmade'}</span><span>{th ? 'ผ้าคราม & ไหมไทย' : 'Indigo & Thai silk'}</span><span>{t(lang, 'label.anyColour')}</span></span>
    </div>
  </div>
</section>

<style>
  .hero-book { position: relative; padding: calc(var(--header) + 36px) 0 0; overflow: hidden; color: #EDE7DA; }
  .book { position: relative; display: grid; grid-template-columns: 1fr 1fr; height: clamp(500px, 68vh, 640px); perspective: 2600px;
    box-shadow: 0 2px 0 #D9CCB2, 0 4px 0 #EEE5D3, 0 6px 0 #D2C4A8, 0 8px 0 #E8DECA, 0 50px 90px -30px rgba(3,8,22,.8); border-radius: 3px; }
  .book::after { /* gutter */ content: ""; position: absolute; z-index: 6; top: 0; bottom: 0; left: 50%; width: 90px; transform: translateX(-50%); pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(30,20,8,.12) 38%, rgba(30,20,8,.32) 50%, rgba(30,20,8,.12) 62%, transparent); }
  .page { position: relative; }
  .page.left { overflow: hidden; }
  .page.left { border-radius: 3px 0 0 3px; display: grid; place-items: center; padding: 30px; }
  .page.right { border-radius: 0 3px 3px 0; color: var(--ink);
    background: radial-gradient(120% 90% at 70% 20%, #FFFDF8, var(--paper-hi) 55%, #EFE7D7); }

  /* Bookplate pasted on the endpaper */
  .bookplate { position: relative; z-index: 2; width: min(460px, 100%); padding: clamp(28px, 4vw, 46px); color: var(--ink); background: var(--paper-hi);
    box-shadow: 0 24px 40px -24px rgba(0,0,0,.6); outline: 1px solid rgba(181,135,58,.45); outline-offset: -10px; animation: rise .8s var(--ease) 1.5s both; }
  .bookplate h1 { font-size: clamp(48px, 5.4vw, 80px); line-height: 1; margin: 14px 0 16px; }
  :global(:lang(th)) .bookplate h1 { font-size: clamp(42px, 4.4vw, 66px); line-height: 1.25; }
  .bookplate h1 em { color: var(--ochre); display: block; }
  .lede { color: var(--muted); margin: 0 0 24px; font-size: 16px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .ctas small { opacity: .7; font-size: 12px; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }

  /* Right page items */
  .leaf-item { position: absolute; inset: 0; display: grid; grid-template-rows: 1fr auto; padding: 44px 50px 70px; opacity: 0; visibility: hidden; transition: opacity .35s, visibility .35s; }
  .leaf-item.active { opacity: 1; visibility: visible; }
  .pic { position: relative; display: grid; place-items: center; min-height: 0; }
  .pic::before { content: ""; position: absolute; inset: 6% 12%; background: var(--ground); box-shadow: inset 0 0 0 1px rgba(0,0,0,.04); }
  .pic :global(img) { position: relative; max-height: 100%; width: auto; max-width: 78%; object-fit: contain; filter: drop-shadow(0 26px 22px rgba(36,30,26,.38)); transition: transform .8s var(--ease); }
  .pic:hover :global(img) { transform: scale(1.04) rotate(-1.5deg); }
  .cap { display: grid; grid-template-columns: 1fr auto; gap: 0 16px; align-items: baseline; padding-top: 18px; border-top: 1px solid var(--faint); }
  .cap .no { grid-column: 1 / -1; font-size: 12px; letter-spacing: .14em; color: var(--muted); }
  .cap .name { font: 500 28px/1.2 var(--display); text-decoration: none; }
  :global(:lang(th)) .cap .name { font: 400 22px/1.5 var(--serif-th); }
  .cap .name:hover { color: var(--kram); }
  .cap .pr { color: var(--ochre); font-weight: 500; }
  .tag { position: absolute; right: 34px; top: 0; transform-origin: 50% 0; animation: swing 6s ease-in-out infinite; }
  .tag .string { display: block; width: 1px; height: 54px; margin: 0 auto; background: #BFA87E; }
  .tag .card { display: block; width: 92px; padding: 18px 8px 12px; text-align: center; background: var(--kraft); font: 500 12px/1.3 var(--body); clip-path: polygon(22% 0, 78% 0, 100% 14%, 100% 100%, 0 100%, 0 14%); position: relative; }
  .tag .card::before { content: ""; position: absolute; top: 7px; left: 50%; width: 8px; height: 8px; margin-left: -4px; border-radius: 50%; background: var(--kram-deep); box-shadow: 0 0 0 2px #E8DCC2; }
  .tag .card b { display: block; font: 500 28px/1 var(--serif-th); color: var(--kram); margin-bottom: 2px; }
  @keyframes swing { 0%,100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }
  .ribbon { position: absolute; z-index: 5; top: -6px; right: 160px; width: 26px; height: 120px; background: linear-gradient(90deg, #7E2418, #A9382A 45%, #8A2B1D); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 88%, 0 100%); animation: sway 7s ease-in-out infinite; transform-origin: top; }
  @keyframes sway { 50% { transform: rotate(1.5deg); } }

  .pager { position: absolute; z-index: 7; left: 50px; bottom: 20px; display: flex; align-items: center; gap: 14px; font-size: 14px; color: var(--muted); }
  .pager b { color: var(--ink); font-weight: 500; }
  .pg { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--faint); background: var(--paper-hi); cursor: pointer; font-size: 22px; line-height: 1; transition: background .3s, color .3s; }
  .pg:hover { background: var(--kram); color: #fff; }

  /* The turning page */
  .turn { position: absolute; inset: 0; z-index: 8; transform-origin: left center; pointer-events: none; opacity: 0;
    background: linear-gradient(90deg, #E7DDCB, var(--paper-hi) 30%, #F3ECDF 70%, #E2D7C3); box-shadow: -10px 0 30px rgba(0,0,0,.15); }
  .turn.fwd { animation: turnFwd .8s cubic-bezier(.45,.05,.3,1) both; }
  .turn.back { animation: turnBack .8s cubic-bezier(.45,.05,.3,1) both; }
  @keyframes turnFwd { 0% { opacity: 1; transform: rotateY(0); } 70% { opacity: .95; } 100% { opacity: 0; transform: rotateY(-165deg); } }
  @keyframes turnBack { 0% { opacity: 0; transform: rotateY(-165deg); } 30% { opacity: .95; } 100% { opacity: 1; transform: rotateY(0); } }
  .page.right { perspective: 2200px; }

  /* Cover */
  .cover { position: absolute; z-index: 9; top: 0; bottom: 0; left: 50%; width: 50%; transform-origin: left center; transform-style: preserve-3d; animation: openCover 1.7s cubic-bezier(.6,.05,.25,1) .45s both; }
  .cover-front, .cover-back { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 0 3px 3px 0; }
  .cover-front { display: grid; place-items: center; box-shadow: inset 14px 0 18px -10px rgba(0,0,0,.5); }
  .cover-back { transform: rotateY(180deg); border-radius: 3px 0 0 3px; }
  .frame { display: grid; place-items: center; gap: 10px; padding: 50px 40px; border: 1px solid rgba(226,196,126,.55); outline: 1px solid rgba(226,196,126,.25); outline-offset: 8px; text-align: center; }
  .frame .sc { color: #CDB98C; }
  .frame .foil { font: 500 clamp(56px, 6vw, 90px)/1.2 var(--serif-th);
    background: linear-gradient(100deg, #8C6622 0%, #E8CD8A 22%, #B98C3D 40%, #F4E4B4 55%, #A07732 75%, #DDBB70 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  @keyframes openCover { to { transform: rotateY(-180deg); visibility: hidden; } }
  .cover { pointer-events: none; }

  .hero-foot { display: flex; justify-content: center; padding: 34px 0 30px; font-size: 14px; color: #B8C1D9; }
  .dots span + span::before { content: "·"; margin: 0 12px; opacity: .6; }

  @media (prefers-reduced-motion: reduce) {
    .cover { display: none; }
    .bookplate, .tag, .ribbon { animation: none; }
    .turn { display: none; }
  }
  @media (max-width: 860px) {
    .book { grid-template-columns: 1fr; height: auto; box-shadow: 0 40px 60px -30px rgba(3,8,22,.8); }
    .book::after, .cover, .turn { display: none; }
    .page.left { padding: 40px 18px; }
    .bookplate { animation-delay: .1s; }
    .page.right { height: 520px; }
    .leaf-item { padding: 40px 24px 76px; }
    .pager { left: 24px; }
    .ribbon { right: 120px; }
  }
</style>

<script>
  const book = document.getElementById('book');
  if (book) {
    const items = [...book.querySelectorAll<HTMLElement>('.leaf-item')];
    const turn = book.querySelector<HTMLElement>('.turn')!;
    const countEl = book.querySelector<HTMLElement>('.count b')!;
    const thai = document.documentElement.lang === 'th';
    const fmt = (n: number) => (thai ? String(n).replace(/\d/g, (d) => '๐๑๒๓๔๕๖๗๘๙'[+d]) : String(n));
    const animate = matchMedia('(min-width: 861px) and (prefers-reduced-motion: no-preference)');
    let i = 0, busy = false;
    function show(n: number) {
      items[i].classList.remove('active'); items[i].setAttribute('aria-hidden', 'true');
      i = (n + items.length) % items.length;
      items[i].classList.add('active'); items[i].removeAttribute('aria-hidden');
      countEl.textContent = fmt(i + 1);
    }
    function go(dir: number) {
      if (busy) return;
      if (!animate.matches) { show(i + dir); return; }
      busy = true;
      turn.className = 'turn ' + (dir > 0 ? 'fwd' : 'back');
      setTimeout(() => show(i + dir), dir > 0 ? 260 : 520);
      setTimeout(() => { turn.className = 'turn'; busy = false; }, 820);
    }
    book.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-turn]');
      if (b) go(Number(b.dataset.turn));
    });
    // swipe on touch
    let x0 = 0;
    book.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    book.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1); });
  }
</script>
