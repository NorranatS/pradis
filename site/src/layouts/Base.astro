---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OrderDialog from '../components/OrderDialog.astro';
import { site } from '../config/site';
import { t, switchHref, base, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Header starts transparent over a dark hero */
  onDark?: boolean;
  image?: string;
}
const { lang, title, description = site.tagline[lang], onDark = false, image } = Astro.props;
const pageTitle = title ? `${title} · ${site.name[lang]}` : `${site.name[lang]} · ${site.tagline[lang]}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang="th" href={new URL(switchHref(path, 'th'), Astro.site)}>
  <link rel="alternate" hreflang="en" href={new URL(switchHref(path, 'en'), Astro.site)}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  {image && <meta property="og:image" content={new URL(image, Astro.site)}>}
  <meta name="theme-color" content="#142040">
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Serif+Thai:wght@300;400;500;600&family=IBM+Plex+Sans+Thai+Looped:wght@400;500&family=Charmonman:wght@400;700&display=swap" rel="stylesheet">
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <Header lang={lang} onDark={onDark} />
  <main><slot /></main>
  <Footer lang={lang} />

  <div class="mobile-bar">
    <span>{t(lang, 'mobile.contact')}</span>
    <button class="btn solid small" data-order>{t(lang, 'cta.contact')}</button>
  </div>
  <OrderDialog lang={lang} />
  <div class="toast" role="status" aria-live="polite"></div>

  <script>
    import '../scripts/site';
  </script>
</body>
</html>
