---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Thread from '../../components/Thread.astro';
import HeroBook from '../../components/HeroBook.astro';
import maker from '../../assets/maker.jpg';
import { links, site } from '../../config/site';
import { t, href, digits, price, lines, types, materials, localePaths, type Lang } from '../../i18n';

export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const th = lang === 'th';

const all = await getCollection('products');
const byNew = [...all].sort((a, b) => b.data.added.localeCompare(a.data.added));
const shelf = [...byNew.filter((p) => p.data.featured), ...byNew.filter((p) => !p.data.featured)].slice(0, 10);
const heroItems = byNew.filter((p) => p.data.featured).slice(0, 6);
const feat = all.find((p) => p.data.slug === 'mint-market-tote') ?? byNew[0];
const count = (l: string) => all.filter((p) => p.data.line === l).length;
const lineInfo = (['knit', 'craft'] as const).map((l) => {
  const mine = byNew.filter((p) => p.data.line === l);
  const picks = [...mine.filter((p) => p.data.featured), ...mine.filter((p) => !p.data.featured)];
  // one of each type first, so the three pictures show the range
  const seen = new Set<string>(); const show = [];
  for (const p of picks) if (!seen.has(p.data.type) && show.length < 3) { seen.add(p.data.type); show.push(p); }
  for (const p of picks) if (show.length < 3 && !show.includes(p)) show.push(p);
  return { key: l, info: lines[l], count: mine.length, show, typesUsed: lines[l].types.filter((ty) => mine.some((p) => p.data.type === ty)) };
});
const f = feat.data;
const fLabel = `${f.name[lang]} (${t(lang, 'label.no')} ${digits(lang, f.no, 2)})`;
---
<Base lang={lang} onDark>
  <!-- 1. Open notebook hero -->
  <HeroBook lang={lang} items={heroItems} total={all.length} />

  <!-- 2. Two lines: ประดิษฐ์ถัก and ประดิษฐ์คราฟท์ -->
  <section class="lines-sec">
    <div class="wrap">
      <div class="lines-head reveal">
        <p class="sc">{site.name[lang]}</p>
        <h2>{th ? <>สองสายงาน <em>จากมือแม่</em></> : <>Two lines, <em>one pair of hands</em></>}</h2>
      </div>
      <div class="lines-grid">
        {lineInfo.map((L, i) => (
          <article class:list={['line-card', L.key]}>
            <div class:list={['under back', i === 0 ? 'kraftpaper' : 'linen']}></div>
            <div class:list={['line-body top reveal', `d${i}`, L.key === 'craft' ? 'bookcloth' : 'sheet']}>
              <p class="sc">{th ? `สายงานที่ ${digits(lang, i + 1)}` : `Line ${i + 1}`}</p>
              <h3>{L.info[lang]}</h3>
              <p class="motto">{L.info.motto[lang]}</p>
              <p class="about">{L.info.about[lang]}</p>
              <div class="pics" aria-hidden="true">
                {L.show.map((p) => <span class="pic"><Image src={p.data.images[0]} alt="" width={260} /></span>)}
              </div>
              <p class="mats"><span>{th ? 'วัสดุ' : 'Materials'}</span>{L.info.materials.map((m) => <b>{materials[m]?.[lang]}</b>)}</p>
              <nav class="types" aria-label={L.info[lang]}>
                {L.typesUsed.map((ty) => <a href={href(lang, `/collection?line=${L.key}&type=${ty}`)}>{types[ty][lang]}</a>)}
              </nav>
              <a class:list={['btn', L.key === 'craft' ? 'solid' : 'ink']} href={href(lang, `/collection?line=${L.key}`)}>
                {th ? `ดู${L.info.th}ทั้งหมด` : `See all of ${L.info.en}`} <small>{digits(lang, L.count)}</small>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. The shelf: every new piece in one swipeable row -->
  <section class="shelf-sec">
    <span class="deco scrap bookcloth pinked" style="width:200px;height:140px;right:-40px;top:30px;rotate:10deg" data-depth="-0.06"></span>
    <div class="wrap shelf-head">
      <div class="label-card sheet top reveal">
        <p class="sc">{th ? 'ใหม่ในสมุด' : 'Fresh from the hook'}</p>
        <h2>{th ? <>ชิ้นล่าสุด<em>ของแม่</em></> : <>Mom’s <em>latest</em></>}</h2>
      </div>
      <div class="shelf-side reveal d1">
        <div class="cat-links">
          {(['knit', 'craft'] as const).map((c) => (
            <a class="chip" href={href(lang, `/collection?line=${c}`)}>{lines[c][lang]} <small>{digits(lang, count(c))}</small></a>
          ))}
        </div>
        <div class="arrows">
          <button class="arrow" data-shelf="-1" aria-label="Previous">←</button>
          <button class="arrow" data-shelf="1" aria-label="Next">→</button>
        </div>
      </div>
    </div>
    <div class="shelf" id="shelf">
      {shelf.map((p, i) => <ProductCard product={p} lang={lang} index={i} layered={false} eager={i < 4} />)}
      <a class="shelf-more sheet" href={href(lang, '/collection')}>
        <span class="n">{digits(lang, all.length)}</span>
        <span>{th ? 'ดูผลงานทั้งหมด →' : 'See every piece →'}</span>
      </a>
    </div>
  </section>

  <div class="stitched">
    <Thread />

    <!-- 3. Featured piece -->
    <section class="featured">
      <div class="wrap feat-grid">
        <div class="stage" data-thread="5" data-ty="0.2">
          <div class="under u1 kraftpaper"></div>
          <div class="under u2"></div>
          <span class="under bignum">{digits(lang, f.no, 2)}</span>
          <a class="bag top" href={href(lang, `/collection/${f.slug}`)} data-tilt="5"><Image src={f.images[0]} alt={f.name[lang]} width={900} /></a>
          <span class="chip-note top reveal d1" style="top:22%"><b>01</b>{th ? 'ถักมือทุกห่วง' : 'Every loop by hand'}</span>
          <span class="chip-note top reveal d2" style="top:46%"><b>02</b>{th ? 'ลายตาข่าย V โปร่งเบา' : 'Light, open V-stitch'}</span>
          <span class="chip-note top reveal d3" style="top:70%"><b>03</b>{t(lang, 'label.anyColour')}</span>
        </div>
        <div class="feat-card sheet top reveal d1">
          <p class="sc">{th ? 'ชิ้นเด่นประจำเล่ม' : 'Featured piece'} · {digits(lang, f.no, 2)}</p>
          <h2>{f.name[lang]}</h2>
          <p class="pr">{price(lang, f.priceFrom)}</p>
          <p class="desc">{f.story[lang]}</p>
          <div class="hours"><b>{digits(lang, f.hours)}</b><span>{t(lang, 'unit.hoursLong')}</span></div>
          <dl class="mini">
            <dt>{t(lang, 'label.material')}</dt><dd>{f.materials.map((m) => materials[m]?.[lang]).join(', ')}</dd>
            <dt>{t(lang, 'label.size')}</dt><dd>{f.size}</dd>
          </dl>
          <div class="row-cta">
            <button class="btn ink" data-order={fLabel}>{t(lang, 'cta.order')} →</button>
            <a class="link-arrow" href={href(lang, `/collection/${f.slug}`)}>{t(lang, 'cta.details')}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. The big number -->
    <section class="statement">
      <div class="wrap" data-thread="96" data-ty="0.25">
        <div class="under strip kraftpaper"></div>
        <div class="panel bookcloth top reveal">
          <span class="huge">{digits(lang, 20)}</span>
          <div>
            <h2>{th ? 'ชั่วโมง คือเวลาที่แม่ใช้ถักกระเป๋าหนึ่งใบ' : 'hours is what one bag takes from Mom’s hands'}</h2>
            <p>{th ? 'ไม่มีเครื่องจักร ไม่มีแม่พิมพ์ มีแค่เข็มโครเชต์หนึ่งเล่ม เส้นด้าย และความตั้งใจ ทุกใบจึงมีใบเดียวในโลก' : 'No machines, no moulds. One hook, one thread and a lot of care, so every bag exists only once.'}</p>
            <a class="btn ghost light" href={href(lang, '/story')}>{th ? 'อ่านเรื่องของแม่ →' : 'Read Mom’s story →'}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Maker teaser -->
    <section class="maker">
      <div class="wrap maker-grid">
        <div class="photo-wrap" data-thread="8" data-ty="0.25">
          <div class="under cloth bookcloth"></div>
          <figure class="print sheet top reveal" data-tilt="4">
            <Image src={maker} alt={th ? 'แม่กับกระเป๋าที่ถักเอง' : 'Mom with one of her bags'} width={800} />
            <figcaption class="hand">{th ? 'แม่ (ซ้าย) กับใบโปรด' : 'Mom (left) with a favourite'}</figcaption>
          </figure>
        </div>
        <div class="quote-card sheet top reveal d1">
          <p class="sc">{th ? 'ผู้ประดิษฐ์' : 'The maker'}</p>
          <blockquote>{th ? <>“ของที่ทำด้วยมือ จะมี<em>หัวใจของคนทำ</em>ติดไปด้วยเสมอ”</> : <>“Something made by hand always carries <em>a little of the maker’s heart.</em>”</>}</blockquote>
          <p class="sig hand">— {th ? 'แม่' : 'Mom'}</p>
          <a class="link-arrow" href={href(lang, '/story')}>{t(lang, 'nav.story')} →</a>
        </div>
      </div>
    </section>

    <!-- 6. How to order -->
    <section class="howto">
      <div class="wrap">
        <div class="under strip2 linen"></div>
        <div class="label-card sheet top reveal">
          <p class="sc">{t(lang, 'nav.order')}</p>
          <h2>{th ? <>สั่งทำง่าย ๆ <em>สามขั้นตอน</em></> : <>Ordering in <em>three easy steps</em></>}</h2>
        </div>
        <div class="steps" data-thread="55" data-ty="0.5">
          <div class="step sheet top reveal"><div class="n">{digits(lang, 1)}</div><h3>{th ? 'เลือกชิ้นที่ชอบ' : 'Pick a piece'}</h3><p>{th ? 'จดชื่อหรือหมายเลขชิ้นงานไว้ เลือกสีเองได้' : 'Note its name or number. Choose any colour.'}</p></div>
          <div class="step sheet top reveal d1"><div class="n">{digits(lang, 2)}</div><h3>{th ? 'ทักหาแม่' : 'Message Mom'}</h3><p>{th ? 'ทาง LINE, Instagram หรือ Facebook แม่ตอบเอง' : 'On LINE, Instagram or Facebook. Mom replies herself.'}</p></div>
          <div class="step sheet top reveal d2"><div class="n">{digits(lang, 3)}</div><h3>{th ? 'รอรับของขวัญ' : 'Receive it'}</h3><p>{th ? 'พร้อมส่ง 2–3 วัน สั่งทำประมาณ 1–3 สัปดาห์' : 'Ready pieces ship in 2–3 days; made-to-order takes 1–3 weeks.'}</p></div>
        </div>
        <div class="channels-row reveal">
          <a class="channel line sheet top" href={links.line} target="_blank" rel="noopener"><span class="ico">LINE</span><span><b>LINE</b><small>ID: {site.contact.lineId}</small></span></a>
          <a class="channel ig sheet top" href={links.instagram} target="_blank" rel="noopener"><span class="ico">IG</span><span><b>Instagram</b><small>@{site.contact.instagram}</small></span></a>
          <a class="channel fb sheet top" href={links.messenger} target="_blank" rel="noopener"><span class="ico">FB</span><span><b>Messenger</b><small>Facebook</small></span></a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ── Shelf ── */
  .shelf-sec { position: relative; padding: 90px 0 90px; }
  .shelf-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: 36px; }
  .shelf-side { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .cat-links { display: flex; gap: 6px; flex-wrap: wrap; }
  .cat-links .chip { text-decoration: none; }
  .arrows { display: flex; gap: 8px; }
  .arrow { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--faint); background: var(--paper-hi); cursor: pointer; font-size: 18px; transition: background .3s, color .3s; }
  .arrow:hover { background: var(--kram); color: #fff; }
  .shelf { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(190px, 17vw, 240px); gap: 26px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding: 30px max(20px, (100% - 1180px) / 2) 40px; scroll-padding-inline: max(20px, (100% - 1180px) / 2); scrollbar-width: none; }
  .shelf::-webkit-scrollbar { display: none; }
  .shelf :global(.pcard) { scroll-snap-align: start; }
  .shelf-more { scroll-snap-align: start; display: grid; place-content: center; text-align: center; gap: 6px; text-decoration: none; color: var(--kram); background: var(--sage-pale); }
  .shelf-more .n { font: 500 90px/1 var(--serif-th); color: var(--ochre); }
  @media (min-width: 1100px) { .shelf { padding-inline: max(70px, (100% - 1180px) / 2); scroll-padding-inline: max(70px, (100% - 1180px) / 2); } }

  /* ── Featured ── */
  .featured { padding: 50px 0 100px; }
  .feat-grid { display: grid; grid-template-columns: repeat(12, 1fr); align-items: center; }
  .stage { grid-column: 1 / span 7; grid-row: 1; position: relative; height: clamp(420px, 56vh, 520px); }
  .stage .u1 { inset: 4% 10% 10% 0; rotate: -1.5deg; }
  .stage .u2 { inset: 14% 0 0 16%; rotate: 1deg; background: var(--sage-pale); box-shadow: var(--shadow); }
  .stage .bignum { left: 2%; top: -8%; font: 500 clamp(120px, 14vw, 210px)/1 var(--serif-th); color: rgba(181,135,58,.22); }
  .stage .bag { position: absolute !important; inset: 12% 10% 8% 24%; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center; }
  .stage .bag :global(img) { max-height: 100%; max-width: 100%; width: auto; height: auto; filter: drop-shadow(0 34px 28px rgba(36,30,26,.4)); rotate: -0.75deg; }
  .chip-note { position: absolute !important; left: -2%; display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: var(--paper-hi); box-shadow: var(--shadow); font-size: 14px; white-space: nowrap; }
  .chip-note b { font: 500 13px var(--body); color: var(--ochre); }
  .feat-card { grid-column: 7 / span 6; grid-row: 1; padding: clamp(28px, 3vw, 44px); margin-left: -20px; rotate: 0.15deg; outline: 1px solid rgba(181,135,58,.35); outline-offset: -10px; }
  .feat-card h2 { font-size: clamp(38px, 4vw, 60px); margin: 10px 0 6px; }
  :global(:lang(th)) .feat-card h2 { font-size: clamp(30px, 3vw, 44px); }
  .pr { font: 500 20px var(--body); color: var(--ochre); margin: 0 0 12px; }
  .desc { color: var(--muted); margin: 0; max-width: 44ch; }
  .hours { display: flex; align-items: baseline; gap: 14px; margin: 16px 0 4px; padding: 12px 0; border-block: 1px solid var(--faint); }
  .hours b { font: 500 46px/1 var(--serif-th); color: var(--ochre); }
  .hours span { color: var(--muted); }
  .mini { display: grid; grid-template-columns: auto 1fr; gap: 4px 20px; font-size: 15px; margin: 14px 0 26px; }
  .mini dt { color: var(--muted); }
  .mini dd { margin: 0; }
  .row-cta { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  @media (max-width: 900px) {
    .stage, .feat-card { grid-column: 1 / -1; grid-row: auto; }
    .stage { height: 460px; }
    .feat-card { margin: -40px 8px 0; }
    .chip-note { left: 0; }
  }

  /* ── Statement ── */
  .statement { padding: 40px 0 130px; }
  .statement .strip { left: 6%; right: 12%; top: -30px; bottom: 50px; rotate: -1.1deg; }
  .panel { color: #EDE7DA; display: grid; grid-template-columns: auto 1fr; gap: clamp(30px, 5vw, 80px); align-items: center; padding: clamp(50px, 7vw, 100px) clamp(30px, 6vw, 90px); rotate: 0.5deg; box-shadow: 0 40px 70px -40px rgba(5,10,25,.8); }
  .huge { font: 500 clamp(150px, 21vw, 320px)/.82 var(--serif-th); color: #E2C47E; }
  .panel h2 { font-size: clamp(34px, 4.2vw, 62px); }
  :global(:lang(th)) .panel h2 { font-size: clamp(28px, 3.2vw, 46px); }
  .panel p { color: #C3CBE0; max-width: 42ch; margin: 18px 0 26px; }
  @media (max-width: 760px) { .panel { grid-template-columns: 1fr; } }

  /* ── Maker ── */
  .maker { padding: 30px 0 140px; }
  .maker-grid { display: grid; grid-template-columns: repeat(12, 1fr); align-items: center; }
  .photo-wrap { grid-column: 1 / span 6; grid-row: 1; position: relative; }
  .photo-wrap .cloth { inset: -40px 40px 60px -40px; rotate: -1.5deg; box-shadow: 0 30px 60px -30px rgba(5,10,25,.6); }
  .print { margin: 0; padding: 16px 16px 50px; rotate: 0.8deg; }
  .print :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: 20% 35%; }
  .print figcaption { position: absolute; left: 16px; right: 16px; bottom: 12px; font-size: 20px; }
  .quote-card { grid-column: 6 / span 7; grid-row: 1; padding: clamp(40px, 5vw, 70px); margin-left: -10px; rotate: -0.5deg; }
  .quote-card blockquote { margin: 18px 0 0; font: 500 clamp(32px, 3.6vw, 52px)/1.25 var(--display); }
  :global(:lang(th)) .quote-card blockquote { font: 400 clamp(26px, 2.8vw, 40px)/1.7 var(--serif-th); }
  .quote-card blockquote :global(em) { color: var(--terra); }
  .sig { font-size: 28px; margin: 16px 0 18px; }
  @media (max-width: 900px) { .photo-wrap, .quote-card { grid-column: 1 / -1; grid-row: auto; } .quote-card { margin: -30px 8px 0; } .photo-wrap .cloth { inset: -20px 20px 40px -10px; } }

  /* ── How to order ── */
  .howto { padding: 20px 0 140px; }
  .strip2 { left: -3%; right: 4%; top: 46%; height: 200px; rotate: 0.6deg; box-shadow: var(--shadow); }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 40px; }
  .step { padding: 32px 30px 34px; }
  .step:nth-child(1) { rotate: -0.7deg; }
  .step:nth-child(2) { rotate: 0.5deg; margin-top: 50px; }
  .step:nth-child(3) { rotate: -0.4deg; margin-top: 16px; }
  .step .n { font: 500 64px/1 var(--serif-th); color: var(--ochre); }
  .step h3 { font-size: 30px; margin: 14px 0 6px; }
  :global(:lang(th)) .step h3 { font-size: 22px; }
  .step p { margin: 0; color: var(--muted); font-size: 15px; }
  .channels-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 60px; }
  .channels-row .channel { border: 0; }
  @media (max-width: 760px) { .steps, .channels-row { grid-template-columns: 1fr; } .step { margin-top: 0 !important; } }


  /* ── Two lines ── */
  .lines-sec { padding: 100px 0 40px; }
  .lines-head { text-align: center; margin-bottom: 50px; }
  .lines-head h2 { font-size: clamp(42px, 5vw, 72px); margin-top: 8px; }
  :global(:lang(th)) .lines-head h2 { font-size: clamp(32px, 3.8vw, 54px); }
  .lines-head h2 em { color: var(--ochre); }
  .lines-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: stretch; }
  .line-card { position: relative; }
  .line-card .back { inset: 16px -12px -14px 16px; rotate: 1.2deg; box-shadow: var(--shadow); }
  .line-card.craft .back { inset: 16px 16px -14px -12px; rotate: -1.2deg; }
  .line-body { height: 100%; display: flex; flex-direction: column; padding: clamp(28px, 3.4vw, 46px); outline: 1px solid rgba(181,135,58,.38); outline-offset: -9px; rotate: -.4deg; }
  .line-card.craft .line-body { rotate: .4deg; color: #EDE7DA; box-shadow: 0 30px 50px -28px rgba(5,10,25,.8); outline-color: rgba(226,196,126,.45); }
  .line-card.craft .sc { color: #B8C1D9; }
  .line-body h3 { font-size: clamp(40px, 4.4vw, 64px); margin: 8px 0 6px; }
  :global(:lang(th)) .line-body h3 { font-size: clamp(32px, 3.4vw, 48px); }
  .line-card.craft h3 { background: linear-gradient(100deg, #B98C3D, #F4E4B4 45%, #C9A050); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .motto { font: italic 500 20px/1.4 var(--display); color: var(--kram); margin: 0 0 10px; }
  :global(:lang(th)) .motto { font: 400 17px/1.6 var(--serif-th); }
  .line-card.craft .motto { color: #E2C47E; }
  .about { color: var(--muted); margin: 0 0 18px; font-size: 15px; }
  .line-card.craft .about { color: #C3CBE0; }
  .pics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0 0 18px; }
  .pics .pic { aspect-ratio: 1; display: grid; place-items: center; padding: 10%; background: var(--sage-pale); box-shadow: inset 0 0 0 1px rgba(0,0,0,.04); }
  .pics .pic:nth-child(2) { background: var(--apricot-pale); }
  .pics .pic:nth-child(3) { background: var(--butter); }
  .line-card.craft .pics .pic { background: rgba(255,255,255,.08); box-shadow: inset 0 0 0 1px rgba(226,196,126,.25); }
  .pics :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; filter: drop-shadow(0 10px 8px rgba(0,0,0,.25)); }
  .mats { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; margin: 0 0 12px; font-size: 14px; }
  .mats span { color: var(--muted); margin-right: 4px; }
  .line-card.craft .mats span { color: #B8C1D9; }
  .mats b { font-weight: 500; padding: 2px 10px; border: 1px solid rgba(181,135,58,.45); border-radius: 3px; }
