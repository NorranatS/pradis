---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { t, href, digits, price, lines, types, statuses, colours, materials, localePaths, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return localePaths().flatMap(({ params, props }) =>
    products.map((product) => ({ params: { ...params, slug: product.data.slug }, props: { ...props, product, products } })),
  );
}
const { lang, product, products } = Astro.props as { lang: Lang; product: CollectionEntry<'products'>; products: CollectionEntry<'products'>[] };
const p = product.data;
const og = await getImage({ src: p.images[0], width: 1200, format: 'png' });
const related = products
  .filter((x) => x.data.slug !== p.slug)
  .map((x) => ({ x, score: (x.data.line === p.line ? 1 : 0) + (x.data.type === p.type ? 2 : 0) + x.data.colours.filter((c) => p.colours.includes(c)).length + x.data.materials.filter((m) => p.materials.includes(m)).length }))
  .sort((a, b) => b.score - a.score || a.x.data.no - b.x.data.no)
  .slice(0, 4).map((r) => r.x);
const orderLabel = `${p.name[lang]} (${t(lang, 'label.no')} ${digits(lang, p.no, 2)})`;
// extra photos (back, inside, close-ups) shown below as real photos from Mom
const gallery = await Promise.all(p.images.slice(1).map(async (img) => ({ thumb: await getImage({ src: img, width: 520, height: 520, fit: 'cover' }), full: await getImage({ src: img, width: 1400 }) })));
const bg = ['var(--sage-pale)', 'var(--apricot-pale)', 'var(--butter)', '#E6DCCB', 'var(--rose-pale)', '#D9E0EA'][(p.no * 7) % 6];
---
<Base lang={lang} title={p.name[lang]} description={p.story[lang]} image={og.src}>
  <article class="product">
    <span class="deco scrap bookcloth pinked" style="width:260px;height:180px;left:-60px;top:140px;rotate:-9deg" data-depth="-0.06"></span>
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={href(lang, '/collection')}>{t(lang, 'nav.collection')}</a> /
        <a href={href(lang, `/collection?line=${p.line}`)}>{lines[p.line][lang]}</a> /
        <a href={href(lang, `/collection?line=${p.line}&type=${p.type}`)}>{types[p.type][lang]}</a>
      </nav>
      <div class="pgrid2">
        <div class="stage">
          <div class="under u1 kraftpaper"></div>
          <div class="under u2" style={`background:${bg}`}></div>
          <span class="under bignum">{digits(lang, p.no, 2)}</span>
          <div class="pic top" data-tilt="6">
            <Image src={p.images[0]} alt={p.name[lang]} width={900} loading="eager" />
          </div>
        </div>
        <div class="info sheet top reveal">
          <p class="sc">{lines[p.line][lang]} · {types[p.type][lang]} · {t(lang, 'label.no')} {digits(lang, p.no, 2)}</p>
          <h1>{p.name[lang]}</h1>
          <p class="pr">{price(lang, p.priceFrom)} <span class:list={['st', p.status]}>{statuses[p.status][lang]}</span></p>
          <p class="story">{p.story[lang]}</p>
          <div class="hours"><b>{digits(lang, p.hours)}</b><span>{t(lang, 'unit.hoursLong')}</span></div>
          <dl class="specs">
            <dt>{t(lang, 'label.material')}</dt><dd>{p.materials.map((m) => materials[m]?.[lang] ?? m).join(', ')}</dd>
            <dt>{t(lang, 'label.technique')}</dt><dd>{p.technique[lang]}</dd>
            <dt>{t(lang, 'label.size')}</dt><dd>{p.size}</dd>
            <dt>{t(lang, 'label.colours')}</dt>
            <dd class="cols">
              {p.colours.map((c) => <span><i style={`background:${colours[c]?.hex}`}></i>{colours[c]?.[lang]}</span>)}
              {p.status !== 'coming-soon' && <span class="any">· {t(lang, p.line === 'knit' ? 'label.anyColour' : 'label.anyCloth')}</span>}
            </dd>
          </dl>
          {p.status !== 'coming-soon'
            ? <button class="btn solid big" data-order={orderLabel}>{t(lang, 'cta.order')} →</button>
            : <button class="btn ghost big" data-order={orderLabel}>{lang === 'th' ? 'แจ้งเตือนเมื่อพร้อม' : 'Tell me when ready'}</button>}
          <p class="motto"><b>{lines[p.line][lang]}</b> · {lines[p.line].motto[lang]}</p>
          <p class="howto"><a class="link-arrow" href={href(lang, '/order')}>{t(lang, 'nav.order')} →</a></p>
        </div>
      </div>
    </div>
  </article>

  {gallery.length > 0 && (
    <section class="real">
      <div class="wrap">
        <div class="label-card sheet top reveal">
          <p class="sc">{lang === 'th' ? 'ภาพถ่ายจริง' : 'Real photos'}</p>
          <h2>{lang === 'th' ? <>ภาพจริง<em>จากแม่</em></> : <>Straight from <em>Mom’s table</em></>}</h2>
        </div>
        <div class="real-grid">
          {gallery.map((g, i) => (
            <a class={`print sheet top reveal d${i % 3}`} href={g.full.src} target="_blank" rel="noopener" data-tilt="4">
              <img src={g.thumb.src} width="520" height="520" alt={`${p.name[lang]} ${i + 2}`} loading="lazy" decoding="async">
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="related">
    <div class="wrap">
      <div class="label-card sheet top reveal"><h2>{t(lang, 'related')}</h2></div>
      <div class="rgrid">
        {related.map((r, i) => <ProductCard product={r} lang={lang} index={i} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .product { position: relative; padding: calc(var(--header) + 30px) 0 90px; }
  .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 26px; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--ink); text-decoration: underline; }
  .pgrid2 { display: grid; grid-template-columns: repeat(12, 1fr); align-items: center; }
  .stage { grid-column: 1 / span 7; grid-row: 1; position: relative; height: min(76vh, 680px); min-height: 460px; }
  .stage .u1 { inset: 4% 10% 8% 0; rotate: -1.5deg; }
  .stage .u2 { inset: 12% 0 0 14%; rotate: 1deg; box-shadow: var(--shadow); }
  .stage .bignum { left: 2%; top: -4%; font: 500 clamp(150px, 18vw, 280px)/1 var(--serif-th); color: rgba(181,135,58,.22); }
  .pic { position: absolute !important; inset: 6% 6% 4% 12%; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center; }
  .pic :global(img) { max-height: 100%; width: auto; max-width: 92%; object-fit: contain; filter: drop-shadow(0 40px 30px rgba(36,30,26,.4)); }
  .info { grid-column: 7 / span 6; grid-row: 1; padding: clamp(32px, 4vw, 54px); margin-left: -10px; rotate: 0.25deg; }
  .info h1 { font-size: clamp(44px, 5vw, 76px); margin: 12px 0 10px; }
  :global(:lang(th)) .info h1 { font-size: clamp(34px, 3.8vw, 56px); }
  .pr { font: 500 22px var(--body); color: var(--ochre); margin: 0 0 14px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .st { font-size: 13px; padding: 4px 12px; border-radius: 999px; background: var(--paper); color: var(--muted); }
  .st.ready { color: var(--sage); }
  .st.coming-soon { color: var(--terra); }
  .story { color: var(--muted); margin: 0; max-width: 46ch; }
  .hours { display: flex; align-items: baseline; gap: 14px; margin: 22px 0 6px; padding: 16px 0; border-block: 1px solid var(--faint); }
  .hours b { font: 500 60px/1 var(--serif-th); color: var(--ochre); }
  .hours span { color: var(--muted); }
  .specs { display: grid; grid-template-columns: auto 1fr; gap: 6px 22px; font-size: 15px; margin: 16px 0 28px; }
  .specs dt { color: var(--muted); }
  .specs dd { margin: 0; }
  .cols { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; }
  .cols span { display: inline-flex; align-items: center; gap: 6px; }
  .cols i { width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); }
  .cols .any { color: var(--muted); }
  .big { padding: 18px 34px; font-size: 16px; }
  .howto { margin: 18px 0 0; font-size: 14px; }
  .motto { margin: 22px 0 0; padding-top: 14px; border-top: 1px dashed var(--faint); font-size: 14px; color: var(--muted); }
  .motto b { color: var(--ochre); font-weight: 500; }
  .related { padding: 20px 0 110px; }
  .rgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 36px 26px; margin-top: 46px; }
  @media (max-width: 900px) {
    .stage, .info { grid-column: 1 / -1; grid-row: auto; }
    .stage { height: 420px; min-height: 0; }
    .info { margin: -30px 6px 0; }
    .rgrid { grid-template-columns: repeat(2, 1fr); gap: 24px 16px; }
  }

  @media (max-width: 760px) {
    .product { padding-bottom: 60px; }
    .stage { height: 340px; }
    .stage .bignum { font-size: 110px; }
    .info { padding: 26px 22px 28px; }
    .info h1 { font-size: 36px; }
    :global(:lang(th)) .info h1 { font-size: 27px; }
    .pr { font-size: 18px; }
    .story { font-size: 14.5px; }
    .hours b { font-size: 40px; }
    .specs { font-size: 14px; }
    .big { padding: 15px 26px; font-size: 15px; }
    .rgrid { gap: 18px 12px; margin-top: 24px; }
  }

  /* Real photos */
  .real { padding: 10px 0 70px; }
  .real-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-top: 40px; }
  .real-grid .print { display: block; padding: 10px 10px 28px; }
  .real-grid .print:nth-child(odd) { rotate: -.8deg; }
  .real-grid .print:nth-child(even) { rotate: .8deg; margin-top: 18px; }
  .real-grid img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  @media (max-width: 760px) {
    .real-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 22px; }
    .real-grid .print { padding: 7px 7px 18px; }
    .real-grid .print:nth-child(even) { margin-top: 10px; }
  }
</style>
